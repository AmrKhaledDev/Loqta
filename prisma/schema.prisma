generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =============================================== Enums
enum Role {
  USER
  SELLER
  ADMIN
  SUPER_ADMIN
}

enum ProductStatus {
  IN_CART
  ORDERED
  CANCELLED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
  NO_ANSWER
}

// =============================================== Models
model User {
  id            String        @id @default(cuid())
  name          String
  email         String        @unique
  password      String
  emailVerified Boolean       @default(false)
  image         String?
  phone         String?
  country       String?
  city          String?
  address       String?
  role          Role          @default(USER)
  opinions      Opinion[]
  userProducts  UserProduct[]
  likes         Like[]
  orders        Order[]
  createdAt     DateTime      @default(now())

  @@map("users")
}

model Product {
  id               String         @id @default(cuid())
  name             String
  price            Float
  brandWebsite     String?
  discountPrice    Float?
  isOnSale         Boolean        @default(false)
  stock            Float
  min_stock        Float
  description      String
  categoryId       String
  warranty         String?
  returnPolicy     String?
  shippingInfo     String?
  brandLogoIsImage Boolean        @default(false)
  brandLogoImage   String?
  brandLogoLink    String?
  category         Category       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  productImages    ProductImage[]
  createdAt        DateTime       @default(now())
  opinions         Opinion[]
  userProducts     UserProduct[]
  salesCount       Int            @default(0)
  isDeleted        Boolean        @default(false)
}

model ProductImage {
  id        String  @id @default(cuid())
  image     String
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
}

model Opinion {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  opinion   String
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating    Int
  createdAt DateTime @default(now())
  likes     Like[]
}

model Like {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  opinionId String
  opinion   Opinion @relation(fields: [opinionId], references: [id], onDelete: Cascade)

  @@unique([userId, opinionId])
}

model UserProduct {
  id         String        @id @default(cuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId  String
  product    Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity   Int           @default(1)
  priceAtAdd Float
  status     ProductStatus @default(IN_CART)
  createdAt  DateTime      @default(now())
  order      Order?        @relation(fields: [orderId], references: [id])
  orderId    String?
}

model Order {
  id           String        @id @default(cuid())
  order_num    Int           @default(autoincrement())
  userId       String
  user         User          @relation(fields: [userId], references: [id])
  totalPrice   Float
  address      String
  phone        String
  city         String
  fullName     String
  status       OrderStatus   @default(PENDING)
  items        UserProduct[]
  createdAt    DateTime      @default(now())
  cancelReason String?
  isCanceled   Boolean       @default(false)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}
